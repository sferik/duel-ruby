<% if reusable? -%>
name: Duel

# Duel's Perf workflow, reusable: a project's own Perf workflow (as
# `duel init` writes it) calls it, with its triggers and its
# concurrency, and passes on what .duel.rb sets that it needs as its
# inputs. Its jobs run as the whole Perf workflow's that
# `duel init --standalone` writes do, and the caller grants contents: write (GitHub checks each job's
# permissions against the caller's, whether it runs or not, and those
# that mark a push passed, comment on it, or keep the badge write) and
# pull-requests: read (for the labels), which each job narrows: the Duel
# job, which runs the branch's code, to contents: read. See Duel's
# docs/ci.md.
on:
  workflow_call:
    inputs:
      ruby-version:
        description: The Ruby the Duel job runs (default, as .ruby-version names it)
        type: string
        default: default
      version-file:
        description: Whether each version runs on the Ruby its .ruby-version names (c.ruby = :version_file)
        type: boolean
        default: false
      jit:
        description: The JIT the benchmarks run with on (Ruby runs one at most), none, yjit (RUBY_YJIT_ENABLE=1), or zjit (RUBY_ZJIT_ENABLE=1, on Ruby 4.0 or later)
        type: string
        default: none
      runs-on:
        description: The runner the Duel job runs on (a larger one, say, for steadier timings), Linux, macOS or Windows
        type: string
        default: ubuntu-latest
      timeout-minutes:
        description: The minutes the Duel job may take before it's cancelled
        type: number
        default: 60
      working-directory:
        description: The project's directory, from the repository's root
        type: string
        default: .
      gemfile:
        description: The Gemfile of the bundle Duel runs in (BUNDLE_GEMFILE), from the project's directory, or none for the project's own
        type: string
        default: ""
      submodules:
        description: Whether to check out the repository's submodules too (true, or recursive), as actions/checkout takes it
        type: string
        default: "false"
      setup:
        description: Shell commands that set up what else the tests need (packages, services), before Ruby's
        type: string
        default: ""
      setup-after-ruby:
        description: Shell commands that set up what needs Ruby first (on Windows, a package of Ruby's devkit, from pacman, say), before the bundle's installed
        type: string
        default: ""
      report:
        description: A name for this call's report (yjit, say), where the workflow calls this one more than once. The Perf comment workflow comments with every call's, each under its name
        type: string
        default: ""
      badge:
        description: Whether to keep a badge for the README
        type: boolean
        default: false
    # What Duel said, for the caller's own jobs (a notice, say).
    outputs:
      comment:
        description: Whether Duel said to comment (post or change), or nothing
        value: ${{ jobs.duel.outputs.comment }}
      status:
        description: The run's status (passed, failed or neutral), or nothing where Duel didn't get to compare
        value: ${{ jobs.duel.outputs.status }}
      passed:
        description: Whether to mark a push passed (true), or nothing
        value: ${{ jobs.duel.outputs.passed }}

<% else -%>
name: Perf<%= " (#{working_directory})" if working_directory %>

on:
  pull_request:
  merge_group: # (a merge queue's)
  push:
    branches: [main] # (and any other branch to guard, a stable one, say)
  schedule:
    - cron: "0 4 * * *"
  workflow_dispatch:

# A pull request's newer push cancels its run, if that's still going, as
# only its newest commit's result counts. Every other run (a push's, say)
# runs to the end, so that each push is compared.
concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

<% end -%>
# The Duel job runs the branch's code (its benchmarks too), so it only
# reads. Commenting on a commit is the Comment on the commit job's, which
# runs none of it, and commenting on a pull request is the Perf comment
# workflow's.
permissions:
  contents: read
  pull-requests: read # for the pull request's labels (see c.accept_label)

jobs:
  duel:
<% if reusable? -%>
    name: Duel${{ inputs.report != '' && format(' ({0})', inputs.report) || '' }}
    runs-on: ${{ inputs.runs-on }}
    timeout-minutes: ${{ inputs.timeout-minutes }}
<% else -%>
    name: Duel
    runs-on: ubuntu-latest
<% end -%>
    # Whether to comment (post, change or none), the run's status (passed,
    # failed or neutral), and whether to mark a push passed (true, or
    # nothing), from Duel.
    outputs:
      comment: ${{ steps.compare.outputs.comment }}
      status: ${{ steps.compare.outputs.status }}
      passed: ${{ steps.compare.outputs.passed }}
<% if working_directory -%>
    # The project is in a subdirectory of the repository: Duel runs there,
    # and checks out the whole repository for the baseline.
<% end -%>
<% if working_directory || reusable? -%>
    defaults:
      run:
<% if reusable? -%>
        shell: bash # (on every runner: on Windows, not PowerShell, but Git's, and once Ruby's set up, its devkit's)
<% end -%>
<% if working_directory -%>
        working-directory: <%= working_directory %>
<% end -%>
<% end -%>
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0 # the baseline comes from history, tags included
          persist-credentials: false
<% if reusable? -%>
          submodules: ${{ inputs.submodules }}
<% end -%>
      # The labels of the pull request (or for a push, of the one that
      # merged it), for c.accept_label in .duel.rb, as a JSON array. They're
      # read as the job runs, and adding the label (or taking it off) runs
      # the job again: see the Perf comment workflow. (On a schedule, Duel
      # finds the last change merged with the label since the last
      # release itself.)
      - name: Find the pull request's labels
        id: labels
        if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.event_name == 'push'
        continue-on-error: true # (without them, nothing's accepted)
        env:
          GH_TOKEN: ${{ github.token }}
          PR: ${{ github.event.pull_request.number }}
          QUEUED: ${{ github.event.merge_group.head_ref }}
        run: |
          # (In a merge queue, the last pull request queued, which the queue's
          # branch names: gh-readonly-queue/main/pr-123-<sha>.)
          if [ -n "$QUEUED" ]; then
            PR=${QUEUED##*/pr-}
            PR=${PR%%-*}
          fi
          if [ -n "$PR" ]; then
            labels=$(gh api "repos/$GITHUB_REPOSITORY/issues/$PR/labels" --jq '[.[].name]')
          else
            labels=$(gh api "repos/$GITHUB_REPOSITORY/commits/$GITHUB_SHA/pulls" --jq '[.[0].labels[]?.name]')
          fi
          echo "labels=$labels" >> "$GITHUB_OUTPUT"
<% if reusable? -%>
      # What else the tests need set up (packages, services), as the
      # caller says.
      - name: Set up
        if: inputs.setup != ''
        env:
          SETUP: ${{ inputs.setup }}
        run: eval "$SETUP"
      # The bundle Duel and both versions' workers run in, where the caller
      # names one of its own (a Gemfile for Duel alone, say): an absolute
      # path, as the baseline's checkout is elsewhere.
      - name: Use the caller's Gemfile
        if: inputs.gemfile != ''
        env:
          GEMFILE: ${{ inputs.gemfile }}
        # (On Windows, as C:/..., not bash's /c/..., which Ruby can't read.)
        run: echo "BUNDLE_GEMFILE=$(pwd -W 2> /dev/null || pwd)/$GEMFILE" >> "$GITHUB_ENV"
      # The JIT the caller says to turn on, YJIT or ZJIT, for every worker
      # of both versions.
      - name: Turn on the JIT
        if: inputs.jit != 'none'
        env:
          JIT: ${{ inputs.jit }}
        run: |
          case "$JIT" in
            yjit) echo "RUBY_YJIT_ENABLE=1" >> "$GITHUB_ENV" ;;
            zjit) echo "RUBY_ZJIT_ENABLE=1" >> "$GITHUB_ENV" ;;
            *) echo "::error::jit: $JIT: give none, yjit or zjit" && exit 1 ;;
          esac
<% else -%>
      # (And whatever else your tests need set up: packages, services.)
<% end -%>
      - uses: ruby/setup-ruby@v1
        id: ruby
        with:
<% if working_directory -%>
          working-directory: <%= working_directory %>
<% end -%>
<% if ruby_version -%>
          ruby-version: "<%= ruby_version %>"
<% end -%>
<% if reusable? -%>
          # (Or once what needs Ruby is set up: see below.)
          bundler-cache: ${{ inputs.setup-after-ruby == '' }}
      # What needs Ruby to set up, as the caller says (on Windows, a
      # package of Ruby's devkit, from pacman, that a gem's native
      # extension links, say), and then the bundle, which may need it.
      - name: Set up, once Ruby is
        if: inputs.setup-after-ruby != ''
        env:
          SETUP: ${{ inputs.setup-after-ruby }}
        run: eval "$SETUP"
      - name: Install the bundle
        if: inputs.setup-after-ruby != ''
        run: bundle install
<% else -%>
          bundler-cache: true
<% end -%>
<% if version_file -%>
      # Each version runs on the Ruby its own .ruby-version names (see
      # .duel.rb). When the baseline's names another Ruby than this code's,
      # that one is installed too, with its bundle, and linked where Duel
      # finds it (as chruby would), and the project's own Ruby, which runs
      # Duel, comes first again. The baseline is the one the Compare step
      # compares with, as Duel finds it (duel base).
      - name: Find the baseline's Ruby
        id: baseline
<% if reusable? -%>
        if: inputs.version-file
<% end -%>
        env:
          # (On a schedule, for the last change a label accepted since the
          # last release, which Duel finds with gh.)
          GH_TOKEN: ${{ github.event_name == 'schedule' && github.token || '' }}
        run: |
          base=$(bundle exec duel base)
          # (None where the commit has no .ruby-version: git fails, which
          # fails the pipeline, under pipefail.)
          ruby_of() { git show "$1:./.ruby-version" 2>/dev/null | awk 'NF { print $1; exit }' || true; }
          ruby=
          # (None without a baseline: a branch's first push, or no release yet.)
          if [ -n "$base" ]; then
            ruby=$(ruby_of "$base")
            [ "$ruby" = "$(ruby_of HEAD)" ] && ruby=
          fi
          echo "ruby=$ruby" >> "$GITHUB_OUTPUT"
      - uses: ruby/setup-ruby@v1
        id: baseline-ruby
        if: steps.baseline.outputs.ruby != ''
        with:
<% if working_directory -%>
          working-directory: <%= working_directory %>
<% end -%>
          ruby-version: ${{ steps.baseline.outputs.ruby }}
          # The bundle for this Ruby too, which the baseline's workers load.
          # (Gems installed for one Ruby version don't load on another.)
<% if reusable? -%>
          # (Or once what needs Ruby is set up: see below.)
          bundler-cache: ${{ inputs.setup-after-ruby == '' }}
<% else -%>
          bundler-cache: true
<% end -%>
      - name: Link the baseline's Ruby where Duel finds it
        if: steps.baseline.outputs.ruby != ''
        env:
          PREFIX: ${{ steps.baseline-ruby.outputs.ruby-prefix }}
          RUBY_PREFIX: ${{ steps.ruby.outputs.ruby-prefix }}
<% if reusable? -%>
          SETUP: ${{ inputs.setup-after-ruby }}
<% end -%>
          MSYS: winsymlinks:nativestrict # (on Windows, bash's ln links, not copies)
        run: |
<% if reusable? -%>
          # (Its bundle, once what needs Ruby is set up: see above.)
          if [ -n "$SETUP" ]; then bundle install; fi
<% end -%>
          # (The project's own Ruby first again, for the steps after: it
          # runs Duel.)
          echo "$RUBY_PREFIX/bin" >> "$GITHUB_PATH"
          # (On Windows, as bash's /c/..., not C:\..., which it can't run.)
          if command -v cygpath > /dev/null; then PREFIX=$(cygpath -u "$PREFIX"); fi
          mkdir -p ~/.rubies
          ln -sfn "$PREFIX" ~/.rubies/ruby-"$("$PREFIX/bin/ruby" -e 'print RUBY_VERSION')"
<% end -%>
      # Against the branch it targets for a pull request, the queue's base
      # for a merge queue, what was there before for a push (or as
      # c.push_base in .duel.rb says, the last commit Duel passed), and the
      # last release on a schedule (slow creep), as Duel finds them, from
      # the run's event. Duel adds its report to
      # the job's summary, writes it to duel.md for the comment, and sets
      # the step's outputs to say whether to comment, as c.comment in
      # .duel.rb says, whatever the outcome.
      - name: Compare
        id: compare
        env:
          # (Run by hand, it compares anyway: with nothing changed, the code
          # with itself, which checks the setup.)
          DUEL_FORCE: ${{ github.event_name == 'workflow_dispatch' && '1' || '' }}
          DUEL_LABELS: ${{ steps.labels.outputs.labels }}
          # (On a schedule, for the last change a label accepted since the
          # last release, which Duel finds with gh.)
          GH_TOKEN: ${{ github.event_name == 'schedule' && github.token || '' }}
        run: bundle exec duel --markdown "$RUNNER_TEMP/duel/duel.md"
      # For a pull request, what Duel said, for the Perf comment workflow,
      # which can't see this job's outputs.
      - name: Say whether to comment
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          PR: ${{ github.event.pull_request.number }}
          COMMENT: ${{ steps.compare.outputs.comment }}
          STATUS: ${{ steps.compare.outputs.status }}
        run: |
          mkdir -p "$RUNNER_TEMP/duel"
          printf 'pr=%s\ncomment=%s\nstatus=%s\n' "$PR" "$COMMENT" "$STATUS" > "$RUNNER_TEMP/duel/comment.env"
      # The report, for the comments.
      - name: Keep the report
        if: ${{ !cancelled() && (github.event_name == 'pull_request' || github.event_name == 'push') }}
        uses: actions/upload-artifact@v7
        with:
          name: duel-report<%= "${{ inputs.report != '' && format('-{0}', inputs.report) || '' }}" if reusable? %>
          path: ${{ runner.temp }}/duel/
          if-no-files-found: ignore # none when Duel didn't get to compare
          retention-days: 1

  # The report, as a new comment on a pushed commit, which notifies its
  # author, when Duel says to, as for a pull request (see the Perf comment
  # workflow). It does only where a regression in a push passes, with
  # c.fail_on = :pull_requests in .duel.rb, so the comment says what the
  # check doesn't. Its last comment is the last one on any commit. This
  # job checks nothing out and runs none of the code.
  commit-comment:
    name: Comment on the commit
    needs: duel
    if: ${{ !cancelled() && github.event_name == 'push' && (needs.duel.outputs.comment == 'post' || needs.duel.outputs.comment == 'change') }}
    runs-on: ubuntu-latest
    permissions:
      contents: write # to comment on the commit with the report
    steps:
      - name: Get the report
        id: report
        continue-on-error: true # there's none when the Duel job failed before comparing
        uses: actions/download-artifact@v8
        with:
          name: duel-report<%= "${{ inputs.report != '' && format('-{0}', inputs.report) || '' }}" if reusable? %>
          path: ${{ runner.temp }}/report
      - uses: ruby/setup-ruby@v1
        if: steps.report.outcome == 'success'
        with:
          ruby-version: ruby
      # Duel's own code, from RubyGems (none of the push's).
      - name: Comment on the commit
        if: steps.report.outcome == 'success'
        env:
          GH_TOKEN: ${{ github.token }}
          DUEL_COMMENT: ${{ needs.duel.outputs.comment }}
          DUEL_STATUS: ${{ needs.duel.outputs.status }}
<% if reusable? -%>
          # (duel, or for a project in a subdirectory, duel and its path.)
          MARKER: ${{ inputs.working-directory == '.' && 'duel' || format('duel {0}', inputs.working-directory) }}
<% end -%>
        run: |
          gem install duel --version '~> <%= Duel::Comment::SINCE %>' --no-document
          duel comment --report "$RUNNER_TEMP/report" --commit "$GITHUB_SHA" --marker <%= reusable? ? '"$MARKER"' : "'#{marker.gsub("'") { "'\\''" }}'" %>

  # With c.push_base = :last_passed in .duel.rb, a push is compared with
  # the last commit Duel passed, which a branch marks (each branch pushed
  # has its own), so slowdowns too small for any one push to fail add up
  # until they fail one. This job moves the branch (as Duel names it) to
  # a push that passed (or makes it), but never back: where a newer
  # push's run moved it first, it stays. It checks nothing out and runs
  # none of the code. To accept a regression, move the branch yourself
  # (for main, git push origin main:<%= passed_branch %>/main).
  passed:
    name: Mark the commit passed
    needs: duel
    # One at a time for each branch, so that two runs can't both find no
    # branch and race to make it (a push's run doesn't wait for the one
    # before it). One that's running is never cancelled, and one that's
    # waiting gives way to a newer push's, which moves it further anyway.
    concurrency:
      group: ${{ github.workflow }}-passed-${{ github.ref_name }}
      cancel-in-progress: false
    if: ${{ !cancelled() && github.event_name == 'push' && needs.duel.outputs.passed != '' }}
    runs-on: ubuntu-latest
    permissions:
      contents: write # to move the branch
    steps:
      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: ruby
      # Duel's own code, from RubyGems (none of the push's).
      - name: Move the branch to the commit
        env:
          GH_TOKEN: ${{ github.token }}
          BRANCH: ${{ needs.duel.outputs.passed }}
        run: |
          gem install duel --version '~> <%= Duel::Comment::SINCE %>' --no-document
          duel mark-passed "$BRANCH"
<% if badge? -%>

  # Duel's badge, for the README: green (perf guarded), red (perf
  # regressed) or grey (not measured), as the last push to the default
  # branch that Duel compared left it. It's red where Duel failed the push
  # or found a regression, even one that passed (with
  # c.fail_on = :pull_requests in .duel.rb), and grey where the Duel job
  # failed before Duel could judge the push (its runner ran out of memory,
  # say). A push with nothing to compare leaves it as it was, and so does
  # a run for an older push than the badge's. This job writes the badge,
  # alone, to a branch of its own, which the README shows:
  #
  #   [![Duel](https://raw.githubusercontent.com/OWNER/REPO/<%= badge_branch %>/badge.svg)](https://github.com/sferik/duel-ruby/blob/main/USERS.md)
  #
  # It checks nothing out, runs none of the code, and fetches nothing.
  badge:
    name: Update the badge
    needs: duel
    # One at a time, so that one run's check of which push the badge
    # shows can't interleave with another run's write (a push's run
    # doesn't wait for the one before it). A badge job that's running is
    # never cancelled, and one that's waiting gives way to a newer push's,
    # whose result the badge should show anyway.
    concurrency:
      group: ${{ github.workflow }}-badge
      cancel-in-progress: false
    if: ${{ <%= "inputs.badge && " if reusable? %>!cancelled() && github.event_name == 'push' && github.ref_name == github.event.repository.default_branch && (needs.duel.result == 'failure' || needs.duel.outputs.status == 'passed' || needs.duel.outputs.status == 'failed') }}
    runs-on: ubuntu-latest
    permissions:
      contents: write # to move the badge's branch
    steps:
      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: ruby
      # Duel's own code, from RubyGems (none of the push's).
      - name: Update the badge
        env:
          GH_TOKEN: ${{ github.token }}
<% if reusable? -%>
          DIRECTORY: ${{ inputs.working-directory }}
<% end -%>
          RESULT: ${{ needs.duel.result }}
          STATUS: ${{ needs.duel.outputs.status }}
        run: |
<% if reusable? -%>
          # (duel/badge, or for a project in a subdirectory, duel/badge-<its
          # path>.)
          branch=duel/badge
          if [ "$DIRECTORY" != . ]; then branch="duel/badge-$(printf %s "$DIRECTORY" | tr / -)"; fi
<% end -%>
          gem install duel --version '~> <%= Duel::Comment::SINCE %>' --no-document
          duel badge <%= reusable? ? '"$branch"' : badge_branch %> --status "$STATUS" --result "$RESULT"
<% end -%>
