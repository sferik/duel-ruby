name: Perf comment<%= " (#{working_directory})" if working_directory %>

# Duel's report, as a new comment on the pull request, when Duel says
# to, by Duel's reusable workflow (see Duel's docs/ci.md), which this
# one calls once the Perf workflow has run, with a token that can write,
# so a pull request from a fork gets a comment too. It checks nothing
# out and runs none of the pull request's code, only `duel comment`.
<% if accept_label -%>
#
# And when the label that accepts a regression (c.accept_label in
# .duel.rb) is added to a pull request, or taken off, it runs the Duel
# job again.
<% end -%>
#
# (The workflow must be on the default branch before it runs at all.)
on:
  workflow_run:
    workflows: ["Perf<%= " (#{working_directory})" if working_directory %>"]
    types: [completed]
<% if accept_label -%>
  pull_request_target:
    types: [labeled, unlabeled]
<% end -%>

permissions: {}

jobs:
  comment:
    uses: <%= REUSABLE %>/duel-comment.yml@v<%= Duel::VERSION %>
    permissions:
<% if accept_label -%>
      actions: write # to get the report from the Perf run, and run its Duel job again
<% else -%>
      actions: read # to get the report from the Perf run
<% end -%>
      pull-requests: write # to comment on the pull request with the report
<% unless comment_inputs.empty? -%>
    with:
<% comment_inputs.each do |name, value| -%>
      <%= name %>: <%= value %>
<% end -%>
<% end -%>
