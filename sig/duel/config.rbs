module Duel
  # What Duel knows about a project (.duel.rb changes what doesn't follow
  # from the conventions).
  class Config
    # Something each worker gets of its own (see #resource): given a
    # Resource, it returns the worker's environment variables.
    type resource = ^(Resource resource) -> Hash[String, String?]

    @root: String
    @benchmarks: String
    @watch: Array[String]
    @library: String | :conventional | nil
    @build: String | :conventional | nil
    @main_branch: String?
    @release_tags: String
    @resources: Array[resource]
    @metrics: Array[singleton(Metric)]
    @workers: Array[^(Stops stops) -> void]
    @measures: Hash[String, Hash[Symbol, untyped]]
    @loader: (^(String version_root) -> void)?

    # Where the project is (and its config file).
    attr_reader root: String

    # A glob, from the root, of the files defining benchmarks.
    attr_accessor benchmarks: String

    # Paths, from the root, whose changes a comparison is about.
    attr_accessor watch: Array[String]

    # The library to require from each version; nil for none.
    attr_writer library (): String?

    # A shell command that builds a checked-out tree; nil for none.
    attr_writer build (): String?

    # The branch a comparison defaults to (nil: the one origin/HEAD names).
    attr_accessor main_branch: String?

    # The glob release tags match (for `--base last-release`).
    attr_accessor release_tags: String

    # What #resource was given.
    # @api private
    attr_reader resources: Array[resource]

    # The metrics #metric added, in order.
    attr_reader metrics: Array[singleton(Metric)]

    # What #worker was given.
    # @api private
    attr_reader workers: Array[^(Stops stops) -> void]

    # Each measure's settings changed, by name.
    # @api private
    attr_reader measures: Hash[String, Hash[Symbol, untyped]]

    # A configuration of the conventions, for the project at +root+.
    def initialize: (?String root) -> void

    # The library: the gem the project's only .gemspec names, unless set.
    %a{pure} def library: () -> String?

    # The build command: `bundle exec rake compile` for a project with
    # ext/ and a Rakefile, unless set.
    %a{pure} def build: () -> String?

    # How a worker loads one version of the code, from the tree at the
    # root it's given, instead of the convention.
    def load_version: () { (String version_root) -> void } -> void

    # Loads the version at +version_root+.
    # @api private
    def load_into: (String version_root) -> void

    # Something each worker gets of its own, started by the runner.
    def resource: () { (Resource resource) -> Hash[String, String?] } -> void

    # Adds a metric to every benchmark: a Duel::Metric subclass, or
    # running totals the block reads (see Snapshot), one by name (with its
    # settings) or several by their settings. Returns the metric: running
    # totals' takes what explains them (.details), typed by what the block
    # read with them, C.
    def metric: (singleton(Metric) klass) -> singleton(Metric)
              # (Totals alone, each a T: no context.)
              | [T < Metric::value] (String name, **untyped settings) { () -> Snapshot::read_totals[T] } -> Snapshot::_Explained[T, nil]
              | [T < Metric::value] (Hash[String, Metric::settings] measures) { () -> Snapshot::read_totals[T] } -> Snapshot::_Explained[T, nil]
              | [T < Metric::value] (**Metric::settings measures) { () -> Snapshot::read_totals[T] } -> Snapshot::_Explained[T, nil]
              # (Totals and their context, C.)
              | [T < Metric::value, C] (String name, **untyped settings) { () -> [Snapshot::read_totals[T], C] } -> Snapshot::_Explained[T, C]
              | [T < Metric::value, C] (Hash[String, Metric::settings] measures) { () -> [Snapshot::read_totals[T], C] } -> Snapshot::_Explained[T, C]
              | [T < Metric::value, C] (**Metric::settings measures) { () -> [Snapshot::read_totals[T], C] } -> Snapshot::_Explained[T, C]

    # Runs the block in each worker, once its version and the benchmarks
    # have loaded and before its metrics are made.
    def worker: () { (Stops stops) -> void } -> void

    # What each worker makes for itself, by the block.
    def per_worker: [T] () { (Stops stops) -> T } -> PerWorker[T]

    # Changes a measure's settings, by its name (skip: true leaves it out).
    def measure: (String name, **untyped settings) -> void

    # Whether a measure is skipped (see #measure).
    def skip?: (String name) -> bool

    # The files that define benchmarks, in order.
    # @api private
    def benchmark_files: () -> Array[String]
  end

  # Silences warnings about redefined constants, while loading a version
  # over files of another's (see Config#load_into).
  # @api private
  module QuietRedefinition : Warning
    REDEFINITION: Regexp

    def self.during: [T] () { () -> T } -> T

    def warn: (String message, ?category: Symbol?) -> nil
  end
end
