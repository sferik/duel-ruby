module Duel
  # The version to compare against: a directory, or a git commit checked
  # out (and built) where #checkout says.
  # @api private
  class Baseline
    LAST_RELEASE: String
    BRANCHES: Array[String]

    @config: Config
    @settings: Settings
    @ref: String?
    @prefix: String?

    def initialize: (Config config, Settings settings) -> void

    # The commit, or nil for "last-release" with no release yet, and for
    # a push with no commit before it here.
    def ref: () -> String?

    # The branch that marks the last commit Duel passed in a push to the
    # branch pushed.
    def passed_branch: () -> String

    # The last commit Duel passed in a push, as checked out (on origin).
    def passed: () -> String

    # Whether nothing #watched changed since the baseline.
    def unchanged?: () -> bool

    # What a change must touch to be compared: the code (Config#watch),
    # and what decides how it's measured (the benchmarks, the
    # configuration's file, and with each version on its own Ruby, its
    # version files).
    def watched: () -> Array[String]

    # The baseline's tree, checked out and built if it's a commit.
    def root: () -> String

    # Where the project is in a checkout of its repository at +dir+.
    def within: (String dir) -> String

    # The project's path from its repository's top level ("" at the top).
    def prefix: () -> String

    # Where a git baseline is checked out: next to the repository, under a
    # hidden name as long as its own, or else tmp/duel/base.
    def checkout: () -> String

    # Removes what Duel keeps: tmp/duel, and the baseline's checkout.
    def clean: () -> void

    # The main branch.
    def main_branch: () -> String

    # Builds the tree in +dir+ (Config#build), if there's a build.
    def build: (String dir, String what) -> void

    private

    # The benchmarks' directory, or for benchmarks at the root, their glob.
    def benchmarks: () -> String

    # The configuration's file, from the root.
    def config_file: () -> String

    # The version files at the root.
    def version_files: () -> Array[String]

    # Where HEAD left the main branch: their merge base, or a failure that
    # says why there's none.
    def merge_base: () -> String

    # A push's baseline: the last commit Duel passed, where
    # Config#push_base says and HEAD has it, or else the commit before the
    # push, or nil where that isn't here.
    def pushed: () -> String?

    # Whether +dir+ is a checkout of this repository.
    def ours?: (String dir) -> bool

    # The repository a directory is a checkout of, or nil for none.
    def common_dir: (String dir) -> String?

    # Git's output. It raises Error when it fails, unless +allow_failure+
    # (then nil).
    def git: (*String args) -> String
           | (*String args, allow_failure: bool) -> String?
  end
end
