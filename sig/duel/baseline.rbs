module Duel
  # The version to compare against: a directory, or a git commit checked
  # out (and built) where #checkout says.
  # @api private
  class Baseline
    LAST_RELEASE: String
    BRANCHES: Array[String]

    @config: Config
    @settings: Settings
    @ref: String?
    @prefix: String?

    def initialize: (Config config, Settings settings) -> void

    # The commit, or nil for "last-release" with no release yet.
    def ref: () -> String?

    # Whether nothing Config#watch names changed since the baseline.
    def unchanged?: () -> bool

    # The baseline's tree, checked out and built if it's a commit.
    def root: () -> String

    # Where the project is in a checkout of its repository at +dir+.
    def within: (String dir) -> String

    # The project's path from its repository's top level ("" at the top).
    def prefix: () -> String

    # Where a git baseline is checked out: next to the repository, under a
    # hidden name as long as its own, or else tmp/duel/base.
    def checkout: () -> String

    # Removes what Duel keeps: tmp/duel, and the baseline's checkout.
    def clean: () -> void

    # The main branch.
    def main_branch: () -> String

    # Builds the tree in +dir+ (Config#build), if there's a build.
    def build: (String dir, String what) -> void

    private

    # Where HEAD left the main branch: their merge base, or a failure that
    # says why there's none.
    def merge_base: () -> String

    # Whether +dir+ is a checkout of this repository.
    def ours?: (String dir) -> bool

    # The repository a directory is a checkout of, or nil for none.
    def common_dir: (String dir) -> String?

    # Git's output. It raises Error when it fails, unless +allow_failure+
    # (then nil).
    def git: (*String args) -> String
           | (*String args, allow_failure: bool) -> String?
  end
end
