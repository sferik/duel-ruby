module Duel
  # Workers of both versions, taking turns.
  # @api private
  class Lane
    TARGET_NS: Integer
    RUNS: Integer
    WARMUP: Integer
    HEAP_CAP: Integer
    STEP: Integer
    MAX_PAIRS: Integer
    # The round of a sample from every worker from which a benchmark
    # judged by process is decided.
    MIN_ROUNDS: Integer
    PROCESS_PAIRS: Integer
    COUNTS: Integer
    JRUBY_COUNTS: Integer
    # The rounds of a sample from every worker a count by process takes.
    COUNT_ROUNDS: Integer
    MEMORY_SAMPLES: Integer
    PROFILE_SAMPLES: Integer
    # A process benchmark's pairs before any are measured, and its runs a
    # sample (unless it says), each sample the fastest of them, as many
    # as take PROCESS_SAMPLE_NS of CPU time.
    PROCESS_WARMUP: Integer
    PROCESS_RUNS: Integer
    PROCESS_SAMPLE_NS: Integer
    # The longest TMPDIR a lane's directory goes in.
    SHORT: Integer

    self.@ids: Integer
    self.@ids_lock: Thread::Mutex

    # Its number (see .next_id).
    @id: Integer
    @dir: String
    @resources: Array[Resource]
    @workers: Array[WorkerProcess]
    @lock: Thread::Mutex
    @config: Config
    @settings: Settings
    @sides: Hash[String, Side]
    # A process benchmark's peak memory samples, by version.
    @peaks: Hash[String, Array[Integer?]]
    @bases: Array[WorkerProcess]
    @candidates: Array[WorkerProcess]
    @profiler: bool
    # The warm-up's seconds (see #warm).
    @warm: Float

    def initialize: (Config config, Settings settings, Hash[String, Side] sides, ?processes: Integer) -> void

    # A number of its own for each lane, from 1.
    def self.next_id: () -> Integer

    # Whether +processes+ workers of each version are enough for a
    # +confidence+ interval over them.
    def self.by_process?: (Integer processes, Float confidence) -> bool

    # A directory for a lane's sockets.
    def self.tmpdir: () -> String

    # Where lanes' directories go: TMPDIR if it's short, else /tmp.
    def self.short_tmp: (?String tmpdir, ?windows: bool) -> String

    # Opens a lane, yields it and always closes it.
    def self.open: [T] (Config config, Settings settings, Hash[String, Side] sides, ?processes: Integer) { (Lane lane) -> T } -> T

    def benchmarks: () -> Hash[String, Definition::summary]

    # The Ruby each version runs on, by version.
    def rubies: () -> Hash[String, String]

    def stop: () -> void

    # Measures one benchmark on both versions.
    def compare: (String name) -> Result

    # Profiles of the benchmark on each version, or nil without StackProf.
    def profile: (String name, Integer n) -> Hash[String, Profile::profile]?

    private

    # How a benchmark runs as a process of its own, or nil.
    def process_of: (String name) -> Definition::process?

    # Each version's first worker, by version.
    def firsts: () -> Hash[String, WorkerProcess]

    def spawn: (String side, Integer index) -> WorkerProcess

    # Fails where a worker's environment turns on one of CRuby's JITs that
    # it doesn't run.
    def check_jit: (String side, WorkerProcess worker, Hash[String, String?] env, String engine) -> void

    # Fails if a version's workers loaded a native extension that isn't a
    # build of its own.
    def check_builds: () -> void

    # Whether +path+ (that +worker+ loaded) is in +side+'s tree, and not
    # in an installed gem.
    def inside?: (String path, String side, WorkerProcess worker) -> bool

    def each_worker: () { (WorkerProcess worker) -> void } -> void

    def set_up: (String name, Result result) -> void

    def metrics: () -> Array[Metric::spec]

    # What the block returns for each item, each on a thread of its own.
    # Adds an item to a list, from a thread of its own.
    def keep: [T] (Array[T] list, T item) -> void

    # Whether workers start (and stop) at once.
    PARALLEL: bool

    # (Untyped: Steep loses a generic in a thread's block.)
    def in_parallel: (Array[untyped] items) { (untyped item) -> untyped } -> Array[untyped]

    def measure: (String name, Result result) -> void

    # A process benchmark's samples.
    def measure_process: (String name, Result result) -> void

    # The runs a process benchmark's sample takes, by its warm-up's.
    def process_runs: (Array[[WorkerProcess::reply, WorkerProcess::reply]] floors) -> Integer

    def warm: (String name, Integer n) -> void

    # The seconds of samples whose median, no faster by STEADY_GAIN than
    # the last's, end a worker's warm-up, without --warm.
    STEADY: Float
    STEADY_GAIN: Float
    STEADY_WINDOWS: Integer

    # Samples a worker until it's steady, or it's +warm_until+.
    def steady: (WorkerProcess worker, String name, Integer n, Float warm_until) -> void

    # STEADY seconds of a worker's samples' CPU time, and when they ended.
    def window: (WorkerProcess worker, String name, Integer n, Float warm_until) -> [Array[Metric::value], Float]

    def judge: (String name, Integer n, Array[[WorkerProcess::reply, WorkerProcess::reply]] floors, Result result) -> void

    # Whether a benchmark's timings are judged by process.
    def by_process?: (String name) -> bool

    # Judges each of +judged+ over workers, in rounds of a sample from
    # every worker.
    def judge_processes: (String name, Integer n, Array[Metric::spec] judged, Result result) -> void

    # The most rounds of +k+ workers' pairs.
    def rounds: (Integer k) -> Integer

    # Each worker's median, by version.
    def medians: (Hash[String, Array[Array[Metric::value]]] values) -> Hash[String, Array[Metric::value]]

    # The baseline's medians, at least 1, and the candidate's.
    def clamped: (Hash[String, Array[Metric::value]] each) -> [Array[Metric::value], Array[Metric::value]]

    # What each worker's medians say against the spec's limit.
    def process_verdict: (Hash[String, Array[Metric::value]] each, Metric::spec spec) -> Stats::verdict

    # Whether both versions' CPU time is below its floor.
    def below_cpu_floor?: (Array[[Worker::sampled, Worker::sampled]] floors) -> bool

    # Whether one version's samples are above a spec's floors.
    def above_floors?: (Array[Hash[String, Metric::value]] samples, Metric::spec spec) -> bool

    # Each pair's ratio: the candidate's value over the baseline's (at least 1).
    def ratios: (Array[[Metric::value, Metric::value]] pairs) -> Array[Float]

    def limit: (Metric::spec spec) -> Float

    def verdict: (Array[Float] ratios, Metric::spec spec) -> Stats::verdict

    # The verdicts that decide a measure at the end of a round, and after
    # any other pair.
    DECISIVE: Hash[bool, Array[Stats::verdict]]

    # Whether +verdict+ decides a measure, at the end of a round or not.
    def decided?: (Stats::verdict verdict, bool round) -> bool

    def calibrate: (String name, Integer target, Integer n) -> Integer

    # The most iterations whose allocations fit HEAP_CAP (infinite when it
    # allocated nothing).
    def most_iterations: (Integer n, Integer heap) -> (Integer | Float)

    # The +index+th pair: [baseline's reply, candidate's].
    def pair: (String name, Integer n, Integer index, ?runs: Integer, ?count: bool) -> [WorkerProcess::reply, WorkerProcess::reply]

    # Round +round+ of pairs by process: yields each pair's workers' indexes and replies.
    def in_round: (String name, Integer n, Integer round, ?runs: Integer, ?count: bool) { (Integer, Integer, WorkerProcess::reply, WorkerProcess::reply) -> void } -> void

    # A sample from a baseline worker and from a candidate worker: [baseline's reply, candidate's].
    def sampled: (String name, Integer n, WorkerProcess base, WorkerProcess candidate, base_first: bool, runs: Integer, count: bool) -> [WorkerProcess::reply, WorkerProcess::reply]

    def count: (String name, Integer n, Result result) -> void

    # The samples a count takes.
    def counts: () -> Integer

    # Each counted measure, by each worker's fewest, and how much more
    # the candidate's are at least.
    def count_by_process: (String name, Integer n, Result result) -> void

    # Keeps each count of a worker's sample where it's that worker's
    # fewest so far.
    def fewest!: (Hash[String, Hash[String, Hash[Integer, Metric::value]]] fewest, String side, Integer worker, WorkerProcess::reply sample) -> void

    def peak_memory: (String name, Integer n, Result result) -> void

    def fresh: [T] (String side) { (WorkerProcess worker) -> T } -> T

    def monotonic: () -> Float
  end
end
