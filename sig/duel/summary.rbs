module Duel
  # A run's report in Markdown, for a pull request.
  # @api private
  class Summary
    # The most characters it has.
    LIMIT: Integer

    # The most lines of an error it shows.
    ERROR_LINES: Integer

    # A benchmark's verdict, and where it goes in the table.
    VERDICTS: Array[String]

    # The verdicts that fail a run.
    FAILED: Array[String]

    # What the heading starts with.
    PASSED_MARK: String
    FAILED_MARK: String
    NEUTRAL_MARK: String

    # What an unsettled timing means.
    UNSETTLED: String

    # How Duel decides that a timing is slower, in its docs.
    DECIDES: String

    @note: String?
    @runner: Runner
    @results: Array[Result]
    @settings: Settings
    @baseline: String
    @candidate: String
    @regressed: Array[Result]
    @failed: Array[Result]

    # +text+ as code, in Markdown.
    def self.code: (String text) -> String

    # +text+ as it is, in Markdown.
    def self.escape: (String text) -> String

    # A run that didn't compare, and why.
    def self.note: (String mark, String title, String reason) -> String

    # +text+ in a fenced block of its own.
    def self.block: (String text) -> String

    # +result+'s verdict.
    def self.verdict: (Result result) -> String

    # The counted measures that differ, an iteration.
    def self.changed_counts: (Result result) -> Hash[String, [Float, Float]]

    def initialize: (Runner runner, Array[Result] results, settings: Settings, baseline: String, candidate: String,
                    ?note: String?) -> void

    # The Markdown.
    def markdown: () -> String

    private

    # The Markdown, with the first +explained+ regressions explained.
    def render: (Integer explained) -> String

    # The verdict.
    def heading: () -> String

    # The two versions, and why any benchmark was skipped.
    def compared: () -> String

    # The benchmarks that failed.
    def failures: () -> String?

    # What got worse, or the error's first line.
    def failure: (Result result) -> String

    # The frame whose own share of the CPU grew the most.
    def top: (Result result) -> String

    # The rest, collapsed.
    def details: (Integer explained) -> String

    # The results, by verdict.
    def sorted: () -> Array[Result]

    # Every benchmark.
    def table: () -> String?

    # A table's row of +cells+.
    def row: (Array[String] cells) -> String

    # +text+ for a table's cell, on one line.
    def cell: (String text) -> String

    # Each timed measure's ratio and its interval.
    def timings: (Result result) -> String

    # Each counted measure that changed, an iteration.
    def counts: (Result result) -> String

    def mb: (Integer bytes) -> String

    # The first +explained+ regressions, explained.
    def regressions: (Integer explained) -> Array[String]

    # The verdicts across the board.
    def across: (confirmed: bool) -> String?

    # The errors of more than a line.
    def errors: () -> Array[String]

    # Each version's Ruby, where they differ.
    def rubies: () -> String?

    # How Duel decides that a timing is slower.
    def decides: () -> String
  end
end
