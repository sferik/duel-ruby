module Duel
  # The statistics behind a verdict: a distribution-free confidence
  # interval for the median of paired ratios, and the decision it supports.
  # @api private
  module Stats
    type verdict = :slower | :faster | :same | :undecided

    # The 1-based ranks [lower, upper] bounding a +confidence+ interval for
    # the median of +n+ samples, or nil when +n+ is too small for one.
    def self.median_ranks: (Integer n, Float confidence) -> [Integer, Integer]?

    # [low, high] bounds of the +confidence+ interval for the median of
    # +samples+, or nil.
    def self.median_interval: (Array[Float] samples, Float confidence) -> [Float, Float]?

    # The rank r whose r-th smallest and largest cross ratio bound a
    # +confidence+ interval for the ratio between two versions, from +m+
    # and +n+ samples, or nil when they're too few.
    def self.shift_rank: (Integer m, Integer n, Float confidence) -> Integer?

    # P(U <= u), from 0 to m * n / 2, for the Mann-Whitney U statistic.
    def self.u_lower_tail: (Integer m, Integer n) -> Array[Float]

    # P(U = u) for u from 0 to +cap+, for samples of +i+ and +j+.
    def self.u_probabilities: (Integer i, Integer j, Integer cap, Hash[[Integer, Integer], Array[Float]] found) -> Array[Float]

    # [low, high] bounds of the +confidence+ interval for the ratio of
    # +candidates+ to +bases+, or nil.
    def self.shift_interval: (Array[Metric::value] bases, Array[Metric::value] candidates, Float confidence) -> [Float, Float]?

    # The median of the cross ratios.
    def self.shift: (Array[Metric::value] bases, Array[Metric::value] candidates) -> Float

    # Each of +candidates+ over each of +bases+, sorted.
    def self.cross_ratios: (Array[Metric::value] bases, Array[Metric::value] candidates) -> Array[Float]

    def self.median: (Array[Float] samples) -> Float
                   | (Array[Metric::value] samples) -> Metric::value

    # What paired ratios say against +limit+.
    def self.verdict: (Array[Float] ratios, limit: Float, confidence: Float) -> verdict

    # What a confidence interval for the median ratio (nil: too few) says
    # against +limit+.
    def self.decide: ([Float, Float]? interval, Float limit) -> verdict
  end
end
