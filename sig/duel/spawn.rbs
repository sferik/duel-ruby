module Duel
  # Starts a process with its output in a log, or pipes for its input and
  # output, and gives the Child to wait for it and stop it by: with
  # Process.spawn's redirects, or through Open3 where spawn can't redirect
  # or wait (JRuby on Windows).
  # @api private
  module Spawn
    # How a process starts: Directly, or ThroughOpen3.
    type starter = singleton(Directly) | singleton(ThroughOpen3)

    REDIRECTS: bool
    WAITS: bool
    SHELL: Regexp
    COPY_WAIT: Integer
    CHUNK: Integer
    LOG_LINES: Integer
    STARTER: starter

    # A process started, to wait for and stop.
    class Child
      GONE: Array[singleton(SystemCallError)]

      attr_reader pid: Integer

      @pid: Integer
      @waiter: Thread?
      @group: bool
      @windows: bool

      def initialize: (Integer pid, ?Thread? waiter, ?group: bool, ?windows: bool) -> void

      # The thread whose value is how it ended (a Process::Status).
      def waiter: () -> Thread

      # Waits for it on a thread from now on: returns itself.
      def detach: () -> self

      def alive?: () -> bool

      # Waits for it, and returns how it ended, and its peak memory where
      # that can be told.
      def wait: () -> [Integer?, Integer?, Integer?]

      # Sends it +signal+: on Windows, kills it with what it started.
      def signal: (String signal) -> void

      # Kills it, with what it started where that can be told, and waits
      # for it to end.
      def kill: () -> void

      # Waits up to +seconds+ for it to end, then kills it.
      def stop: (Numeric seconds) -> void
    end

    # Starts a process with Process.spawn, given its redirects and pipes.
    module Directly
      # Starts +command+, its output and errors in +log+.
      def self.logged: (Hash[String, String?] env, Array[String] command, log: String, mode: String, **untyped options) -> Child

      # Starts +command+ with a pipe each way: its Child, its input and its
      # output.
      def self.piped: (Hash[String, String?] env, Array[String] command, ?group: bool, **untyped options) -> [Child, IO, IO]

      # Starts +command+, its output this process's.
      def self.started: (Hash[String, String?] env, Array[String] command, **untyped options) -> Child
    end

    # Starts a process through Open3, as Directly does.
    module ThroughOpen3
      def self.logged: (Hash[String, String?] env, Array[String] command, log: String, mode: String, **untyped options) -> Child

      def self.piped: (Hash[String, String?] env, Array[String] command, ?group: bool, **untyped options) -> [Child, IO, IO]

      def self.started: (Hash[String, String?] env, Array[String] command, **untyped options) -> Child
    end

    # How a process that failed ended: its exit status, or the signal that
    # killed it.
    def self.why: (Integer? code, Integer? signal) -> String

    # The end of the log at +path+, for a failure to show.
    def self.tail: (String path) -> String

    # +message+, then the end of the log at +path+, if it has any.
    def self.with_tail: (String message, String? path) -> String

    # The log at +path+, opened for a process's output.
    def self.log: (String path, String mode) -> File

    # Open3's +name+d method, on JRuby on Windows with ENV and the
    # program found.
    def self.open3: (Symbol name, *untyped args, ?jruby_on_windows: bool, **untyped options) ?{ (*untyped) -> untyped } -> untyped

    # A command's environment (none, if it doesn't start with one), and
    # the rest.
    def self.environment_and: (Array[untyped] command) -> [Hash[String, String?], Array[untyped]]

    # +command+ as Windows runs it, its program found.
    def self.program: (Array[String] command, ?path: String, ?exts: Array[String]) -> Array[String]

    # +arg+ as a Windows program's command line has it.
    def self.quote: (String arg) -> String

    # Process.spawn's options that start a process in a group of its own:
    # a process group, or on Windows, a console's.
    def self.group: (?windows: bool) -> ({ pgroup: true } | { new_pgroup: true })

    # Kills +pid+ and what it started: its process group, or on Windows,
    # its tree of children.
    def self.kill_tree: (Integer pid, ?windows: bool) -> untyped

    # A thread copying +output+ to +out+, then closing both.
    def self.copy: (IO output, IO out, ?close: bool) -> Thread

    # A thread whose value is +waiter+'s, once +copy+ is done.
    def self.ended: (Thread waiter, Thread copy, *IO outputs) -> Thread
  end
end
