module Duel
  # The `duel` command.
  # @api private
  class CLI
    # The environment (ENV, or a Hash in its place).
    interface _Env
      def reject: () { (String name, String value) -> boolish } -> _Variables
    end

    # What's left of it.
    interface _Variables
      def key?: (String name) -> bool

      def fetch: (String name) -> String
    end

    USAGE: String

    # Where GitHub Actions has a step add to its job's summary.
    STEP_SUMMARY: String

    # Where GitHub Actions has a step set its outputs.
    STEP_OUTPUT: String

    # The statuses the workflow comments on, by when it does.
    COMMENTED: Hash[Config::comment, Array[String]]

    # A run's status as the comment's marker has it.
    MARKED: Hash[String, String]

    # The GitHub Actions events of a pull request.
    PULL_REQUESTS: Array[String]

    # The variables that set options, to their options.
    ENV_OPTIONS: Hash[String, String]

    # The variables that set a flag by being set at all.
    ENV_FLAGS: Hash[String, String]

    @argv: Array[String]
    @env: _Env
    @out: _Output
    @err: _Output
    @clean: bool?
    @markdown: String?
    @json: String?
    @settings: Settings?
    @config: Config?
    @passed: bool?
    @note: String?

    def initialize: (Array[String] argv, ?env: _Env, ?out: _Output, ?err: _Output) -> void

    # Runs, and returns the exit status: 0 not slower (or nothing to compare),
    # 1 slower (or a benchmark failed), 2 couldn't compare.
    def run: () -> Integer

    # The settings, from the environment and then the options.
    # +source+ as a Regexp, or an option's invalid argument.
    def self.regexp: (String source) -> Regexp

    # Whether the workflow comments on a pull request: "post", "change"
    # or "none".
    def self.comment: (Config::comment mode, String status) -> String

    # The mode --comment names, or an invalid argument.
    def self.comment_mode: (String name) -> Config::comment

    # The runs --fail-on names, or an invalid argument.
    def self.fail_on: (String name) -> Config::fail_on

    # Which of +values+ an option's argument names, or an invalid
    # argument.
    def self.named: [T < Symbol] (String name, Array[T] values) -> T

    def parse: () -> Settings

    private

    # What #run does, holding the project's lock.
    def compare: (Config config, Settings settings) -> Integer

    # The exit status of a run that was slower: 1, or 0 where only a pull
    # request fails, outside one.
    def slower: (Config config, Settings settings) -> Integer

    # Passes a run that was slower, with a warning and a note.
    def passing: (String why, String note) -> Integer

    # Whether the pull request's labels have the one that accepts a
    # regression.
    def accepted?: (Config config) -> bool

    # The pull request's labels, from DUEL_LABELS.
    def labels: () -> Array[untyped]

    # Whether the workflow marks a push that passed as the last commit
    # Duel passed.
    def marks_passed?: (Config config, Settings settings) -> bool?

    # Whether a regression fails only a pull request.
    def pull_requests_only?: (Config config, Settings settings) -> bool

    # Whether this is a run on GitHub Actions for something other than a
    # pull request.
    def outside_pull_request?: () -> bool

    # Whether this is a run on GitHub Actions for a pull request.
    def pull_request?: () -> bool

    # Whether this is a run on GitHub Actions for a push.
    def pushed?: () -> bool

    # Says there's nothing to compare, and why, and passes.
    def nothing: (String title, String why) -> Integer

    # Reports a run that didn't compare, and why, and returns +exit+.
    def unfinished: (String mark, String title, String status, String why, Integer exit) -> Integer

    # What the workflow does about its comment on a pull request, or on a
    # pushed commit, for a run of +status+.
    def commenting: (String status) -> String

    # Writes the reports where they're asked for, each made only if it's
    # written, and on GitHub Actions, the step's outputs.
    def publish: (String status, ^() -> String markdown, ^(String comment) -> JSONReport::report json) -> void

    # Writes +text+ to +path+, in a directory made for it.
    def write: (String path, String text) -> void

    # The baseline, in Markdown.
    def described_baseline: (Config config, Settings settings, Baseline baseline) -> String

    # The candidate, in Markdown.
    def described_candidate: (Config config, Settings settings) -> String

    # The baseline, for JSON: the ref that named it, its commit, and its
    # tree.
    def baseline_json: (Config config, Settings settings, Baseline baseline, String root) -> Hash[String, String?]

    # The candidate, for JSON: its commit, whether it has changes not
    # committed, and its tree.
    def candidate_json: (Config config, Settings settings) -> Hash[String, String | bool | nil]

    # Git's output, and its status, in +dir+.
    def git: (String dir, *String args) -> [String, Process::Status]

    # Says so if the two versions' paths differ in length.
    def uneven: (String base_root, String candidate) -> void

    # The DUEL_* variables set, as options.
    def env_options: () -> Array[String]

    # The environment's variables that are set.
    def variables: () -> _Variables

    def parser: (Settings settings) -> OptionParser
  end
end
