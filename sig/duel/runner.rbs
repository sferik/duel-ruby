module Duel
  # Where reports go ($stdout, or a StringIO in its place).
  # @api private
  interface _Output
    def puts: (*_ToS objects) -> nil

    def print: (*_ToS objects) -> void
  end

  # Seconds each benchmark runs before it's measured, unless --warm says.
  # @api private
  JIT_WARM: Float

  # Seconds each benchmark runs before it's measured where a worker has
  # YJIT or ZJIT on, unless --warm says.
  # @api private
  CRUBY_JIT_WARM: Float

  # CRuby's JITs, by the variable that turns each on in a worker.
  # @api private
  JIT_VARIABLES: Hash[String, String]

  # The values of a JIT's variable that turn it on.
  # @api private
  JIT_ON: Array[String]

  # The seconds a run measures for, at most, by default.
  # @api private
  TIME_LIMIT: Float

  # The seconds a worker may take to load, or to answer, by default.
  # @api private
  TIMEOUT: Float

  # The CPUs for each lane of workers, by default.
  # @api private
  CPUS_PER_LANE: Integer

  # Worker processes of each version, by default.
  # @api private
  PROCESSES: Integer

  # How a run is set up (see Duel::CLI for where each comes from).
  # @api private
  class Settings < Struct[String | Regexp | Integer | Float | bool | Config::ruby | Config::comment | Config::fail_on | nil]
    attr_accessor base: String?
    attr_accessor base_dir: String?
    attr_accessor candidate_dir: String?
    attr_accessor filter: Regexp
    attr_accessor jobs: Integer
    attr_accessor processes: Integer
    attr_accessor limit: Float
    attr_accessor confidence: Float
    attr_accessor warm: Float?
    attr_accessor force: bool
    attr_accessor config_path: String?
    attr_accessor timeout: Float
    # The seconds a run measures for, at most (--time-limit).
    attr_accessor time_limit: Float
    # Each version's Ruby (--ruby), over Config#ruby.
    attr_accessor ruby: Config::ruby
    # When the workflow comments on a pull request (--comment), over
    # Config#comment.
    attr_accessor comment: Config::comment?
    # Which runs a regression fails (--fail-on), over Config#fail_on.
    attr_accessor fail_on: Config::fail_on?
    # The branch pushed, where #base is the push's, the commit before it,
    # on GitHub Actions (DUEL_BASE): see Baseline#ref.
    attr_accessor pushed: String?
    # The branch a pull request targets, on GitHub Actions
    # (GITHUB_BASE_REF), on origin: see Baseline#main_branch.
    attr_accessor target: String?
    # On a schedule, the last commit since the last release that merged
    # a pull request with Config#accept_label (DUEL_ACCEPTED): see
    # Baseline#last_release.
    attr_accessor accepted: String?
    # On a schedule on GitHub Actions, the repository (GITHUB_REPOSITORY)
    # Duel finds what was accepted in, without DUEL_ACCEPTED: see
    # Baseline#merged_accepted.
    attr_accessor repository: String?
    # Of jobs and processes, those Duel may lower to fit the memory
    # available (see Runner#fit).
    attr_accessor fit: Array[:jobs | :processes]

    def self.new: (?String? base, ?String? base_dir, ?String? candidate_dir, ?Regexp filter, ?Integer jobs,
                   ?Integer processes, ?Float limit, ?Float confidence, ?Float? warm, ?bool force, ?String? config_path,
                   ?Float timeout, ?Config::ruby ruby, ?Config::comment? comment,
                   ?Config::fail_on? fail_on, ?String? pushed,
                   ?String? target, ?Float time_limit, ?String? accepted, ?String? repository, ?Array[:jobs | :processes] fit) -> instance
                | (?base: String?, ?base_dir: String?, ?candidate_dir: String?, ?filter: Regexp, ?jobs: Integer,
                   ?processes: Integer, ?limit: Float, ?confidence: Float, ?warm: Float?, ?force: bool,
                   ?config_path: String?, ?timeout: Float, ?ruby: Config::ruby, ?comment: Config::comment?,
                   ?fail_on: Config::fail_on?, ?pushed: String?,
                   ?target: String?, ?time_limit: Float, ?accepted: String?, ?repository: String?, ?fit: Array[:jobs | :processes]) -> instance

    def self.defaults: () -> Settings
  end

  # One version as a run has it: its tree, the Ruby its processes run on,
  # and what they get in their environment.
  # @api private
  class Side < Struct[String | Hash[String, String?]]
    attr_accessor name: String
    attr_accessor root: String
    attr_accessor ruby: String
    attr_accessor env: Hash[String, String?]
    # Its Ruby's engine (RUBY_ENGINE).
    attr_accessor engine: String

    # What each version's workers are named for: "base" and "head", as
    # long as each other.
    LABELS: Hash[String, String]

    def self.new: (String name, String root, String ruby, Hash[String, String?] env, String engine) -> instance

    # Each version with nothing prepared: its tree, on the runner's Ruby.
    def self.unprepared: (Config config, Settings settings, String base_root) -> Hash[String, Side]

    # What its workers, and its version's resources, are named for.
    def label: () -> String
  end

  # Measures every benchmark, confirms what looks worse, and reports.
  # @api private
  class Runner
    # A count to four figures, or a whole number from NUMBER.
    def self.number: (Metric::value value) -> String

    # Bytes of memory, in megabytes to a tenth.
    def self.mb: (Integer bytes) -> String

    # The least count #number shows as a whole number.
    NUMBER: Float

    CONFIRM: Integer

    # +number+ of +noun+, in its plural for any number but one.
    def self.count: (Integer number, String noun, ?String plural) -> String

    @config: Config
    @settings: Settings
    @base_root: String
    @out: _Output
    @across: Hash[String, Across::verdict]
    @prepared: Array[Resource]
    @dir: String
    @sides: Hash[String, Side]
    # What the first lane learned of the benchmarks.
    @benchmarks: Hash[String, Definition::summary]

    @rubies: Hash[String, String]
    @seconds: Float
    @lock: Thread::Mutex
    @started: Float
    @unmeasured: Array[String]
    @unconfirmed: Array[String]
    @across_cut: bool

    # What a run cut short at its time limit left undone.
    type cut_short = Hash[String, Array[String] | bool]

    # Across the board: {metric => verdict}. Set by #run.
    attr_reader across: Hash[String, Across::verdict]

    # The Ruby each version ran on, by version. Set by #run.
    attr_reader rubies: Hash[String, String]

    # The seconds the run took. Set by #run.
    attr_reader seconds: Float

    # What the run left undone when it reached its time limit, or nil.
    def cut_short: () -> cut_short?

    def initialize: (Config config, Settings settings, String base_root, ?out: _Output) -> void

    # Returns the Results.
    def run: () -> Array[Result]

    # Whether nothing got slower, and none failed.
    def passed?: (Array[Result] results) -> bool

    def regressed_across: () -> Array[String]

    # What a run cut short at its time limit left undone, or nil.
    def cut_short_note: () -> String?

    # Whether the run has measured for longer than its time limit.
    def out_of_time?: () -> bool

    # The plugins the configuration used, by name.
    def plugins: () -> Array[Symbol]

    # What a regression's report says of it, line by line.
    def explained: (Result result) -> Array[String]

    private

    def monotonic: () -> Float

    # What #run does.
    def compare_all: () -> Array[Result]

    # Each version, prepared once for the run.
    def prepare: () -> Hash[String, Side]

    # What a benchmark's interval is over: the workers, or the pairs.
    def interval_over: () -> String

    # The most workers of each version #interval_over looks at.
    PROCESSES_CHECKED: Integer

    # The memory #fit leaves for everything but the workers.
    RESERVE: Integer

    # How much more than starting them a pair of workers takes, by #fit's
    # reckoning.
    HEADROOM: Float

    # How many times a JIT engine's worker grows as it warms up.
    JIT_GROWTH: Hash[String, Float]

    # Lowers the jobs, then the processes, that Settings#fit lets it, to
    # fit the memory available.
    def fit: () -> void

    # +bytes+ in gigabytes, to a tenth.
    def gigabytes: (Integer bytes) -> String

    def with_lanes: [T] () { (Array[Lane] lanes) -> T } -> T

    def judge_across: (Array[Result] results, Array[String] names) -> Hash[String, Across::verdict]

    # Across the board, of +results+.
    def across_of: (Array[Result] results) -> Across

    def open_lane: () -> Lane

    def measure_all: (Array[Lane] lanes, Array[String] names) -> Array[Result]

    def attempt: (Lane lane, String name) -> Result

    # A benchmark the run reached its time limit before it measured.
    def unmeasured: (String name) -> Result

    def limit_text: () -> String

    def confirm: (Array[Result] suspects) -> void

    def profile: (Array[Result] regressed) -> void

    def report: (Array[Result] results, Float seconds) -> void

    def line: (Result result) -> String

    # The unit of +measured+, for +number+ of it: singular for one.
    def unit: (Metric::value number, Result::timed | Result::counted measured) -> String?

    # What each worse measure measured, an iteration, and what its metric
    # said of it.
    def explanation: (Result result) -> Array[String]

    # A sample's value an iteration.
    def amount: (Metric::value value, Integer n, Result::timed | Result::counted measured) -> String

    def profile_lines: (Result::profile? profile) -> Array[String]
  end
end
