module Duel
  # `duel init`: sets Duel up in a gem or an app that isn't a Rails app.
  # @api private
  class Init
    USAGE: String

    TEMPLATES: String

    # What's added to a Rakefile.
    RAKE_TASK: String

    # What's added to a Gemfile, for profiles of regressions.
    STACKPROF: String

    # A Gemfile's development group.
    DEVELOPMENT: Regexp

    # The color of the label it creates.
    LABEL_COLOR: String

    # Where it reads an answer.
    interface _Input
      def tty?: () -> bool

      def gets: () -> String?
    end

    @argv: Array[String]
    @out: _Output
    @err: _Output
    @input: _Input
    @root: String
    @label: bool?
    @force: bool?
    @dry_run: bool?
    @check: bool?
    @gitlab: bool?
    @badge: bool?
    @settings: Config?
    @stackprof: bool?

    def initialize: (Array[String] argv, ?out: _Output, ?err: _Output, ?input: _Input, ?root: String) -> void

    # Returns the exit status: 0 set up, 1 a Rails app, 2 a bad option.
    def run: () -> Integer

    # The files it writes, from the project's root, to what's in them.
    def files: () -> Hash[String, String]

    private

    def parser: () -> OptionParser

    # Says whether each workflow is what it writes, or how it differs.
    def check: () -> Integer

    # Whether the file at +path+ is +content+, saying so, or how it differs.
    def same?: (String path, String content) -> bool

    # Creates the label that accepts a regression, with gh, if it's missing
    # and the answer to whether to is yes.
    def create_label: () -> void

    # What gh prints, run in the project, or nil.
    def gh: (*String args) -> String?

    # Says to use duel-rails's generator instead.
    def rails: () -> Integer

    # Writes +content+ to +path+, unless it exists, and says what it did.
    def write: (String path, String content) -> void

    # Adds Duel's Rake task to the Rakefile.
    def add_rake_task: () -> void

    # Adds StackProf to the Gemfile: in its development group, or at its end.
    def add_stackprof: () -> void

    # The Gemfile with StackProf last in its development group, or nil.
    def in_development_group: (String text) -> String?

    # What goes between a file's text and what's added at its end.
    def gap: (String text) -> String

    # The Gemfile with StackProf at its end.
    def at_the_end: (String text) -> String

    def said: (String what, String path) -> void

    # What to do next, numbered, after a blank line.
    def next_steps: () -> String

    def render: (String name) -> String

    # The project's configuration, as the conventions have it.
    def config: () -> Config

    # The project's settings, which decide the workflow's jobs (nil where
    # .duel.rb doesn't load).
    def settings: () -> Config?

    def load_settings: () -> Config?

    # The settings of the .duel.rb it writes.
    def written_settings: () -> Config

    # The label that accepts a regression, for the workflows, or nil.
    def accept_label: () -> String?

    # Whether the workflow comments on a pushed commit.
    def comment_on_pushes?: () -> bool

    # Whether the workflow marks a push passed.
    def mark_passed?: () -> bool

    # The library the gemspec names, or nil.
    def library: () -> String?

    # The glob release tags match, for the workflow.
    def release_tags: () -> String

    # The library, without a gemspec: lib/'s only Ruby file, or nil.
    def guess: () -> String?

    # What each version's workers require.
    def required: () -> String?

    def benchmark_file: () -> String

    def gemfile?: () -> bool

    def ext: () -> bool

    def version_file: () -> bool

    # The Ruby the workflow sets up, or none.
    def ruby_version: () -> String?

    # The root of the project's git repository.
    def repository: () -> String

    # The project's directory, from its repository's root, or nil.
    def working_directory: () -> String?

    def workflow_name: () -> String

    # What marks the workflow's comment on a pull request.
    def marker: () -> String

    # The branch that marks the last commit Duel passed in a push.
    def passed_branch: () -> String

    # Whether the workflow keeps a badge for the README (--badge).
    def badge?: () -> bool?

    # The branch that holds the workflow's badge.
    def badge_branch: () -> String

    # Where the GitLab CI jobs are, from the repository's root.
    def gitlab_file: () -> String

    # The GitLab CI job's name.
    def gitlab_job: () -> String

    # The Ruby image's tag for GitLab CI.
    def gitlab_ruby: () -> String
  end
end
