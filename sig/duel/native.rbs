module Duel
  # What the operating system can tell about this process, through Fiddle:
  # instructions retired (hardware counters) and resident memory.
  # @api private
  module Native
    # A C function (a Fiddle::Function) returning an integer.
    interface _Function
      def call: (*untyped args) -> Integer
    end

    FIDDLE: bool
    OS: String
    CPU: String
    WINDOWS_OS: Regexp
    WINDOWS: bool
    UINT64: Integer

    # Loads Fiddle, as the first C function is made.
    def self.require_fiddle: () -> bool

    # A C function of the process's own libraries (or of +library+), by
    # name, taking and returning Fiddle types (:INT, :LONG, :VOIDP...).
    def self.function: (String name, Array[Symbol] args, Symbol returns, ?library: String?) -> _Function

    # Instructions retired in user space, from the CPU's counters.
    class Counter
      @scope: "thread" | "process"

      # The best counter here, or nil.
      def self.open: (?fiddle: bool) -> Counter?

      # Whose instructions it counts.
      attr_reader scope: "thread" | "process"

      def initialize: ("thread" | "process" scope) -> void

      def read: () -> Integer
    end

    # Linux: perf_event_open(2), counting this thread's instructions in
    # user space.
    class Linux < Counter
      SYSCALL: Hash[String, Integer]
      PERF_TYPE_HARDWARE: Integer
      PERF_COUNT_HW_INSTRUCTIONS: Integer
      FLAGS: Integer
      PERF_FLAG_FD_CLOEXEC: Integer
      ATTR_SIZE: Integer

      @io: IO

      def self.open: (?platform: String, ?cpu: String, ?syscall: _Function?) -> Linux?

      def initialize: (IO io) -> void

      def read: () -> Integer
    end

    # macOS: proc_pid_rusage(RUSAGE_INFO_V4), the process's instructions
    # and resident memory.
    class MacOS < Counter
      RUSAGE_INFO_V4: Integer
      SIZE: Integer
      RESIDENT: Integer
      INSTRUCTIONS: Integer

      @rusage: _Function
      # The struct proc_pid_rusage fills in, in place.
      @buffer: String

      def self.open: (?platform: String, ?rusage: _Function?) -> MacOS?

      # The same call, for resident memory alone.
      def self.memory: (?platform: String, ?rusage: _Function?) -> MacOS?

      def initialize: (_Function rusage) -> void

      def read: () -> Integer

      def resident: () -> Integer

      private

      def field: (Integer offset) -> Integer
    end

    # Windows: this process's working set, and the memory available, from
    # kernel32.
    class Windows
      KERNEL32: String
      CURRENT_PROCESS: Integer
      COUNTERS: Integer
      PEAK_WORKING_SET: Integer
      WORKING_SET: Integer
      STATUS: Integer
      AVAILABLE: Integer

      @memory_info: _Function
      @handle: Integer
      # The struct K32GetProcessMemoryInfo fills in, in place.
      @buffer: String

      def self.open: (?platform: String, ?memory_info: _Function?) -> Windows?

      # The bytes of physical memory available, or nil.
      def self.available: (?platform: String, ?status: _Function?) -> Integer?

      def initialize: (_Function memory_info, ?handle: Integer) -> void

      # The bytes in its working set, or nil.
      def resident: () -> Integer?

      # The most bytes its working set has held, or nil.
      def peak: () -> Integer?

      # The CPU cycles charged to this thread or this process, read
      # without allocating.
      class Cycles
        CURRENT_THREAD: Integer
        QUERIES: Hash[:thread | :process, [String, Integer]]

        @handle: Integer
        @query: _Function
        # Where the call writes the count.
        @count: Fiddle::Pointer
        @address: Integer

        def initialize: (:thread | :process scope, ?query: _Function?, ?handle: Integer?) -> void

        # The count, as a Float.
        def read: () -> Float
      end

      # A child process, by a handle of its own: what it took, once it
      # has ended.
      class Spawned
        QUERY: Integer

        @handle: Integer
        @cycles: Cycles | _Reader
        @memory: Windows
        @close: _Function

        interface _Reader
          def read: () -> Float
        end

        # +pid+'s, or nil where it can't be opened.
        def self.open: (Integer pid, ?open_process: _Function?) -> Spawned?

        def initialize: (Integer handle, ?cycles: (Cycles | _Reader)?, ?memory_info: _Function?, ?close: _Function?) -> void

        def cycles: () -> Float

        def peak: () -> Integer?

        def close: () -> Integer
      end

      private

      def counter: (Integer offset) -> Integer?
    end

    # macOS: the calling thread's instructions, from thread_selfcounts.
    class MacOSThread < Counter
      THSC_CPI: Integer
      SIZE: Integer

      @selfcounts: _Function
      # The struct thread_selfcounts fills in, in place.
      @buffer: String

      def self.open: (?platform: String, ?selfcounts: _Function?) -> MacOSThread?

      def initialize: (_Function selfcounts) -> void

      # The count, or nil where the call fails.
      def read: () -> Integer?
    end

    # A child process of this one, waited for.
    module Child
      RUSAGE_SIZE: Integer
      MAXRSS: Integer
      EINTR: Integer

      # Waits for the child +pid+: its exit status (or nil), the signal
      # that killed it (or nil), and its peak memory in bytes (or nil).
      def self.wait: (Integer pid, ?fiddle: bool, ?platform: String, ?wait4: _Function?) -> [Integer?, Integer?, Integer?]
    end

    # This process's resident memory in bytes, or nil where it can't tell.
    module Memory
      STATUS: String
      self.@reader: (MacOS | Windows)?

      # macOS's counter, or Windows's reader, opened as resident memory is
      # first read, or nil.
      def self.opened_reader: () -> (MacOS | Windows)?

      def self.resident: (?status: String, ?reader: (MacOS | Windows)?) -> Integer?

      def self.used: () -> Integer?

      def self.collect: () -> void
    end
  end
end
