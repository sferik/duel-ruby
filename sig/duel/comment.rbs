module Duel
  # `duel comment`: what the Perf comment workflow runs, to comment on a
  # pull request with Duel's report.
  # @api private
  class Comment
    USAGE: String

    # The first release whose `duel comment` the workflow can run.
    SINCE: String

    # Where GitLab CI has what Duel said.
    GITLAB: Hash[String, String]

    # What Duel says in comment.env, as each line must have it.
    SAID: Hash[String, Regexp]

    # The comments on a pull request, a page at a time.
    COMMENTS: String

    # The jq that picks GitHub Actions' token's comments.
    LISTED: String

    @argv: Array[String]
    @env: CLI::_Env
    @out: _Output
    @err: _Output
    @marker: String
    @report: String?
    @head: String?
    @gitlab: bool?

    def initialize: (Array[String] argv, env: CLI::_Env, out: _Output, err: _Output) -> void

    # Returns the exit status: 0 commented (or had nothing to say), 1
    # GitHub wouldn't take it, 2 a bad option.
    def run: () -> Integer

    private

    def parser: () -> OptionParser

    # Comments, if Duel said to, and the pull request's head is still the
    # run's.
    def comment: (String report) -> Integer

    # Posts +body+ as a new comment, or nil.
    def post: (String pr, String body) -> untyped

    # What Duel said in comment.env, or nil.
    def said: (String name, String report) -> String?

    # Duel's comments on the pull request, oldest first, or nil.
    def earlier: (String pr) -> Array[Hash[String, untyped]]?

    # The merge request, as GitLab's API has it, or nil.
    def merge_request: (String pr) -> untyped

    # The token's notes on the merge request, or nil.
    def notes: (String pr) -> Array[Hash[String, untyped]]?

    # What GitLab's API says, or nil.
    def gitlab: (Symbol verb, String path, ?Hash[String, String]? body, ?pages: bool) -> untyped

    # A connection to +uri+'s host, not yet started.
    def connection: (URI::Generic uri) -> Net::HTTP

    # Hides an earlier comment as outdated.
    def hide: (String id) -> void

    # What gh api prints, or nil where it fails.
    def gh: (*String args) -> String?

    # Says why it doesn't comment, and returns 0.
    def quiet: (String why) -> Integer

    def marker: () -> String

    def repository: () -> String

    def project: () -> String
  end
end
