module Duel
  # How long threads waited for the GVL during each sample of a benchmark
  # with threads of its own (gvl_wait).
  module GVL
    VERSION: String

    # Configures Duel for the plugin (c.use :gvl): the gvl_wait metric
    # (where it's available), and the extension, loaded in workers.
    # Returns the metric.
    def self.configure: (Config config) -> singleton(Metric)

    # Whether the extension is loaded to measure with.
    def self.available?: () -> bool

    # Loads the extension (Hook) where it can be; whether it's loaded.
    def self.load_extension: (?engine: String, ?feature: String) -> bool

    # The C extension: the total time threads have waited for the GVL
    # while it's measuring.
    module Hook
      # Starts measuring (again); does nothing while measuring.
      def self.start: () -> nil

      # Stops measuring; the total stays.
      def self.stop: () -> nil

      def self.running?: () -> bool

      # Nanoseconds all threads have waited for the GVL while measuring.
      def self.wait_ns: () -> Integer
    end

    # gvl_wait: nanoseconds all threads waited for the GVL during a
    # sample of a benchmark with threads of its own; judged at CPU_FLOOR
    # of the sample's CPU time or more on either version, slower past
    # LIMIT, and not across the board.
    class Wait < Metric
      CPU_FLOOR: Float

      LIMIT: Float

      @measuring: bool
      @waited: Integer

      def self.available?: () -> bool

      def start_sample: (Sample sample) -> void

      def stop_sample: () -> Integer?
    end
  end
end
