# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# Duel, from this repository: the plugin is tested against it as it
# is here.
gem "duel", path: "../.."

gem "rake"
gem "minitest"
gem "minitest-strict"
gem "standard", ">= 1.57"
gem "standard-performance"
gem "rubocop"
gem "rubocop-performance"
gem "rubocop-minitest"
gem "simplecov", ">= 1.3"

# Profiles of regressions in its own benchmarks (duel/), CRuby's.
gem "stackprof", platforms: :mri

platforms :mri do
  gem "mutant-minitest"
  # Type checking (sig/): Steep doesn't run on JRuby.
  gem "rbs"
  gem "steep"
end
