# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# Duel and duel-activerecord, from this repository: the plugin is
# tested against them as they are here.
gem "duel", path: "../.."
gem "duel-activerecord", path: "../activerecord"
# For Duel's profiles of regressions.
gem "stackprof", platforms: :mri

# The Rails the tests' app runs on (RAILS for another: "~> 7.2.0", say),
# on SQLite.
gem "rails", ENV.fetch("RAILS", ">= 7.2")
gem "sqlite3", ">= 2.0"

gem "rake"
gem "minitest"
gem "minitest-strict"
gem "standard", ">= 1.57"
gem "standard-performance"
gem "rubocop"
gem "rubocop-performance"
gem "rubocop-minitest"
gem "simplecov", ">= 1.3"

platforms :mri do
  gem "mutant-minitest"
  # Type checking (sig/): Steep doesn't run on JRuby.
  gem "rbs"
  gem "steep"
end
