# frozen_string_literal: true

# Duel compares this app's benchmarks (duel/) on two versions of it, each
# booted in the benchmark environment (config/environments/benchmark.rb),
# with a bundle of its own and a database of its own, which its schema
# (and data) is loaded into. See
# https://github.com/sferik/duel-ruby/tree/main/plugins/rails.
Duel.configure do |c|
<% if version_file? -%>
  # Each version runs on the Ruby that its own .ruby-version names, so a
  # change that upgrades Ruby is compared too. Each Ruby must be
  # installed, with rbenv, chruby, mise or asdf, or be the one running
  # Duel.
  c.ruby = :version_file
<% end -%>
<% if fixtures? -%>
  c.use :rails, database: <%= database ? ":#{database}" : "nil" %>, fixtures: :all
<% else -%>
  # To load test/fixtures, or db/seeds.rb, into each worker's database:
  # fixtures: :all, or seeds: true.
  c.use :rails, database: <%= database ? ":#{database}" : "nil" %>
<% end -%>

  # When the workflow comments on a pull request with the report: :always,
  # :results (passed or failed), :failures (failed, or couldn't compare),
  # or :never.
  # c.comment = :failures

  # Which runs a regression fails: :every_run, or :pull_requests, for a
  # project where people push to main directly (on GitHub Actions, another
  # run warns and passes, and a pushed commit gets the comment instead).
  # c.fail_on = :every_run

  # What the workflow compares a push with: :before (the commit before it),
  # or :last_passed (the last commit Duel passed, which the branch
  # duel/passed marks), so small slowdowns add up until they fail a push.
  # c.push_base = :before
end
