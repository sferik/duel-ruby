# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# Duel, from this repository: the plugin is tested against it as it
# is here.
gem "duel", path: "../.."
# For Duel's profiles of a regression (duel/: the plugin's own benchmarks).
gem "stackprof", platforms: :mri
# For the benchmarks' baseline where it's a release before the plugin's
# own client (0.1.8, say), whose connection was Trilogy's. (Not on
# Windows, which Trilogy has no build for, and the benchmarks don't run
# on.)
gem "trilogy", platforms: :ruby

gem "rake"
gem "minitest"
gem "minitest-strict"
gem "standard", ">= 1.57"
gem "standard-performance"
gem "rubocop"
gem "rubocop-performance"
gem "rubocop-minitest"
gem "simplecov", ">= 1.3"

platforms :mri do
  gem "mutant-minitest"
  # Type checking (sig/): Steep doesn't run on JRuby.
  gem "rbs"
  gem "steep"
end
