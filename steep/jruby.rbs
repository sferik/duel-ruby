# JRuby's access to Java packages (java.lang...), which Duel uses on
# JRuby only. For type checking Duel only: not in the gem.
module Kernel
  private

  def java: () -> untyped
end

# What Duel defines on JRuby only.
module Duel
  module Native
    module Memory
      HEAP: untyped
    end
  end
end
