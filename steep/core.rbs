# What RBS's core signatures lack, or leave broader than Duel's uses of
# them need. For type checking Duel only: not in the gem.

module Process
  # Process.spawn([env,] command...), which RBS declares only as
  # Kernel.spawn, and without the environment.
  def self.spawn: (Hash[String, String?] env, *String command, ?in: String, ?close_others: bool) -> Integer
  # And as Resource#spawn passes on what it's given (anything spawn
  # takes), with its log redirections.
              | (*untyped command, **untyped options) -> Integer
end

class Thread::Queue[E = untyped]
  # A queue of +items+ (Ruby 3.1+).
  def initialize: (?_Each[E] items) -> void
end

module Kernel
  # Code in a file (as all of Duel's is) has a directory.
  def __dir__: () -> String
             | ...

  # A method called from a file (as DSL#duel_process is) has a caller.
  def caller_locations: () -> Array[Thread::Backtrace::Location]
                      | ...
end

class Thread::Backtrace::Location
  # A caller in a file has its path.
  def path: () -> String
          | ...
end

class Process::Tms
  # Its children's CPU time (as ProcessSample reads it), which RBS's core
  # leaves out.
  def cutime: () -> Float

  def cstime: () -> Float
end

class Gem::BasicSpecification
  # What WorkerProcess.load_path reads of a loaded gem (a
  # Gem::Specification, with its dependencies), which RBS's core leaves
  # out.
  def full_require_paths: () -> Array[String]

  def runtime_dependencies: () -> Array[Gem::Dependency]
end

class Gem::Dependency
  def name: () -> String
end

class Proc
  # A block (as DSL#duel, #setup and #teardown take) has a location.
  def source_location: () -> [String, Integer]
                     | ...
end

class Exception
  # An exception rescued (as Worker#handle's is) has a backtrace.
  def backtrace: () -> Array[String]
               | ...
end

class String
  # An unsigned 64-bit integer (Duel reads only those).
  def unpack1: ("Q" template, ?offset: int) -> Integer
             | ("q" template, ?offset: int) -> Integer
             | ...
end

module Open3
  # Open3 passes options on to Process.spawn: Duel's is chdir:.
  def self.capture2e: (*String command, chdir: String) -> [String, Process::Status]
                    | ...
end

class Integer
  # Arithmetic with an Integer or a Float (a Metric::value, say), whose
  # overloads Steep doesn't try one by one.
  def +: (Integer) -> Integer
       | (Float) -> Float
       | (Integer | Float) -> (Integer | Float)
       | ...

  def -: (Integer) -> Integer
       | (Float) -> Float
       | (Integer | Float) -> (Integer | Float)
       | ...

  def *: (Integer) -> Integer
       | (Float) -> Float
       | (Integer | Float) -> (Integer | Float)
       | ...
end

class Module
  # A method of a block, run with the method's receiver as self (as
  # DSL.define's, and a benchmark's body: see Harness#bound).
  def define_method: (interned name) { (?) [self: untyped] -> untyped } -> Symbol
                   | ...
end
